# Copy to .env to override the defaults baked into docker-compose.yml.
# Every value below is already the compose default — nothing here is required.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=3307

# --- Java backend ---
JAVA_PROFILE=dev
JAVA_DB_NAME=fleetmanagement_dev
JAVA_HOST_PORT=8080

# --- .NET backend ---
DOTNET_ENVIRONMENT=Development
DOTNET_DB_NAME=fleetmanagement_dotnet_dev
DOTNET_HOST_PORT=5180

# --- Frontend (nginx) ---
FRONTEND_HOST_PORT=5173
# Which backend nginx forwards /api/* to. Use dotnet-backend:8080 for .NET.
API_UPSTREAM=java-backend:8080

# --- Shared ---
FRONTEND_ORIGIN=http://localhost:5173
