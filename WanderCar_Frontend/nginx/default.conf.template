# Rendered to /etc/nginx/conf.d/default.conf at container start by the image's
# 20-envsubst-on-templates.sh entrypoint script, which substitutes ${API_UPSTREAM}.
#
# NOTE: envsubst replaces every ${...} in this file, so nginx's own variables
# are written WITHOUT braces ($host, not ${host}) to survive that pass.

server {
    listen       8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS. Needed because the proxy_pass below uses a
    # variable, which defers upstream resolution to request time.
    resolver 127.0.0.11 valid=10s ipv6=off;

    access_log /dev/stdout;
    error_log  /dev/stderr warn;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json image/svg+xml;

    client_max_body_size 10m;

    # ---- API proxy -------------------------------------------------------
    # Mirrors the Vite dev proxy in vite.config.js: the browser calls
    # same-origin /api/*, nginx forwards to the backend container. This keeps
    # VITE_API_BASE_URL=/api valid in the compiled bundle, so switching
    # backends is an env change, not a rebuild. Same-origin also means no
    # CORS preflight at all.
    location /api/ {
        # Assigning to a variable first is deliberate: with a literal
        # proxy_pass, nginx resolves the hostname once at startup and dies
        # with "host not found in upstream" if the backend isn't up yet,
        # then caches that IP forever across backend restarts.
        set $upstream ${API_UPSTREAM};
        proxy_pass http://$upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Generous read timeout: the invoice-PDF path fans out to the Java
        # service and is the slowest call the UI makes.
        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    # ---- Static assets ---------------------------------------------------
    # Vite fingerprints these filenames, so they are safe to cache hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---- SPA fallback ----------------------------------------------------
    # React Router owns the client-side routes, so a deep link like
    # /booking/confirm must return index.html instead of nginx's 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html must never be cached, or browsers keep loading a stale
    # bundle that references deleted fingerprinted assets after a redeploy.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "SAMEORIGIN" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
}
